<section class="section">
  <div class="wrap" style="max-width:520px;text-align:center">
    <p class="wordmark" style="justify-content:center">{{ settings.brand_name }}</p>
    <h1 class="h2" style="margin-top:24px">{{ section.settings.heading }}</h1>
    <p class="lede" style="margin:18px auto 0">{{ section.settings.body }}</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="form-status form-status--err">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field" style="margin-top:24px;text-align:left">
        <label for="Password">Password</label>
        <input type="password" id="Password" name="password" autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn--primary btn--block">Enter</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "One tool, one package. Nearly ready." }
  ]
}
{% endschema %}
