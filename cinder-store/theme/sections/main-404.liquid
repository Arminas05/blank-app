<section class="section">
  <div class="wrap" style="max-width:640px">
    <h1 class="h2">{{ section.settings.heading }}</h1>
    <p class="lede" style="margin-top:18px">{{ section.settings.body }}</p>
    <a class="btn btn--primary" style="margin-top:12px" href="{{ routes.root_url }}">
      {{ section.settings.cta }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "That page doesn't exist." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "The link may be old, or we may have moved something. There is only one product, so it isn't far away." },
    { "type": "text", "id": "cta", "label": "CTA", "default": "Back to the shop" }
  ]
}
{% endschema %}
