{% comment %}
  Re-rendered by cart.js through the Section Rendering API (?sections=cart-drawer),
  so all cart markup stays here in Liquid rather than being rebuilt in JS.
{% endcomment %}

<div class="drawer-overlay" data-cart-overlay></div>

<aside
  class="drawer"
  data-cart-drawer
  role="dialog"
  aria-modal="true"
  aria-label="Your cart"
  aria-hidden="true">
  <div class="drawer__head">
    <strong style="font:700 18px/1 var(--font);color:var(--ink)">Your cart</strong>
    <button
      type="button"
      data-cart-close
      aria-label="Close cart"
      style="background:none;border:0;font-size:22px;cursor:pointer;color:var(--muted)">
      &times;
    </button>
  </div>

  <div class="drawer__items">
    {%- if cart.item_count == 0 -%}
      <p style="padding:40px 0;color:var(--muted)">Your cart is empty.</p>
    {%- else -%}
      {%- for line in cart.items -%}
        <div class="drawer__row">
          <div style="border:1px solid var(--line-soft);border-radius:8px;overflow:hidden;background:var(--surface)">
            {%- if line.image -%}
              <img
                src="{{ line.image | image_url: width: 144 }}"
                alt="{{ line.image.alt | escape }}"
                width="72"
                height="72"
                loading="lazy"
                style="width:100%;height:auto;display:block">
            {%- endif -%}
          </div>

          <div>
            <a href="{{ line.url }}" style="font:700 15px/1.3 var(--font)">{{ line.product.title }}</a>
            {%- unless line.variant.title contains 'Default' -%}
              <p style="margin:4px 0 0;font-size:13px;color:var(--muted)">{{ line.variant.title }}</p>
            {%- endunless -%}

            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px">
              <div class="qty">
                <button
                  type="button"
                  data-qty-change="{{ line.quantity | minus: 1 }}"
                  data-line-key="{{ line.key }}"
                  aria-label="Decrease quantity">
                  &minus;
                </button>
                <input
                  type="text"
                  value="{{ line.quantity }}"
                  aria-label="Quantity"
                  readonly>
                <button
                  type="button"
                  data-qty-change="{{ line.quantity | plus: 1 }}"
                  data-line-key="{{ line.key }}"
                  aria-label="Increase quantity">
                  +
                </button>
              </div>
              <strong style="font:700 15px/1 var(--font);color:var(--ink)">
                {{ line.final_line_price | money }}
              </strong>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="drawer__foot">
    <div style="display:flex;justify-content:space-between;font:600 15px/1.8 var(--font);color:var(--ink)">
      <span>Subtotal</span>
      <span>{{ cart.total_price | money }}</span>
    </div>
    <div style="display:flex;justify-content:space-between;font:400 15px/1.8 var(--font);color:var(--muted)">
      <span>US shipping</span>
      <span style="color:var(--ok);font-weight:600">Free</span>
    </div>

    <form action="{{ routes.cart_url }}" method="post" style="margin-top:16px">
      <button
        type="submit"
        name="checkout"
        class="btn btn--primary btn--block"
        {% if cart.item_count == 0 %}disabled{% endif %}>
        Checkout
      </button>
    </form>

    <p style="margin:12px 0 0;font-size:12px;line-height:1.6;color:var(--faint);text-align:center">
      {{ section.settings.footnote }}
    </p>
  </div>
</aside>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Taxes and duties included. Shipping calculated at checkout."
    }
  ]
}
{% endschema %}
