{% comment %}
  FAQ accordion.

  Content comes from the shop-level metafield cinder.faq (JSON list of {q, a})
  so the home page, the PDP and /pages/faq all read one source and cannot drift
  (SHOPIFY-HANDOFF.md §1). Section blocks are the fallback when the metafield is
  not set yet, so the theme is usable the moment it is installed.
{% endcomment %}
{%- liquid
  assign faqs = shop.metafields.cinder.faq.value
  assign limit = section.settings.limit
-%}

<section class="section">
  <div class="wrap">
    <div data-reveal style="max-width:72ch">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>

    <div style="margin-top:36px;max-width:80ch">
      {%- if faqs != blank and faqs.size > 0 -%}
        {%- for item in faqs -%}
          {%- if limit > 0 and forloop.index > limit -%}
            {%- break -%}
          {%- endif -%}
          {%- assign uid = section.id | append: '-mf-' | append: forloop.index -%}
          <div class="accordion__item" data-reveal>
            <h3 style="margin:0">
              <button
                class="accordion__trigger"
                type="button"
                aria-expanded="false"
                aria-controls="FaqPanel-{{ uid }}"
                id="FaqTrigger-{{ uid }}">
                <span>{{ item.q }}</span>
                <span class="accordion__sign" aria-hidden="true">+</span>
              </button>
            </h3>
            <div
              class="accordion__panel"
              id="FaqPanel-{{ uid }}"
              role="region"
              aria-labelledby="FaqTrigger-{{ uid }}">
              <div class="accordion__panel-inner">{{ item.a }}</div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if limit > 0 and forloop.index > limit -%}
            {%- break -%}
          {%- endif -%}
          {%- assign uid = section.id | append: '-b-' | append: forloop.index -%}
          <div class="accordion__item" data-reveal {{ block.shopify_attributes }}>
            <h3 style="margin:0">
              <button
                class="accordion__trigger"
                type="button"
                aria-expanded="false"
                aria-controls="FaqPanel-{{ uid }}"
                id="FaqTrigger-{{ uid }}">
                <span>{{ block.settings.question }}</span>
                <span class="accordion__sign" aria-hidden="true">+</span>
              </button>
            </h3>
            <div
              class="accordion__panel"
              id="FaqPanel-{{ uid }}"
              role="region"
              aria-labelledby="FaqTrigger-{{ uid }}">
              <div class="accordion__panel-inner">{{ block.settings.answer }}</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.more_label != blank and limit > 0 -%}
      <p style="margin-top:28px">
        <a class="link-underline" href="{{ section.settings.more_url | default: '/pages/faq' }}">
          {{ section.settings.more_label }}
        </a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads the shop metafield cinder.faq (JSON) when set. The blocks below are the fallback."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The ones people actually ask."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Show first N",
      "info": "0 shows all of them.",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 0
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "See-all link label",
      "default": ""
    },
    {
      "type": "url",
      "id": "more_url",
      "label": "See-all link URL"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
