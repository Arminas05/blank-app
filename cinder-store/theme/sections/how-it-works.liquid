<section class="section">
  <div class="wrap">
    <div data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>

    <div class="grid-3" style="margin-top:48px">
      {%- for block in section.blocks -%}
        <div data-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div style="border:1px solid var(--line-soft);border-radius:var(--radius-sm);overflow:hidden;background:var(--surface);aspect-ratio:4/3;margin-bottom:20px">
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                style="width:100%;height:100%;object-fit:cover;display:block">
            </div>
          {%- endif -%}

          <strong style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:var(--ember);color:#fff;font:800 14px/1 var(--font)">
            {{ forloop.index }}
          </strong>

          <h3 class="h3" style="margin-top:16px">{{ block.settings.heading }}</h3>
          <p style="margin:12px 0 0;font:400 15px/1.7 var(--font);color:var(--body)">
            {{ block.settings.text }}
          </p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three steps. No technique to learn."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "heading": "Let the grate cool to warm",
            "text": "Warm, not hot. Fifteen minutes after the burners go off is the sweet spot: grease is soft, metal is safe to touch through a glove."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Hold the trigger and glide",
            "text": "Don't press. The motor supplies the force, your job is to steer. Run with the bars, not across them, at about the speed you'd butter toast."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Wipe once with a damp cloth",
            "text": "Ten seconds, every time. This is the habit that matters. Then hang the brush by the loop and forget about it until next weekend."
          }
        }
      ]
    }
  ]
}
{% endschema %}
