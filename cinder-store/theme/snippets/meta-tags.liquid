{% comment %}
  Open Graph and Twitter card tags. Without these a shared link renders as a
  bare URL with no image — which is most of how a one-product store gets passed
  around. Shopify does not emit them for you; content_for_header does not
  include them.
{% endcomment %}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_type = 'website'
  assign og_image = page_image | default: settings.share_image

  if request.page_type == 'product'
    assign og_type = 'product'
    assign og_image = product.featured_media | default: og_image
  elsif request.page_type == 'article'
    assign og_type = 'article'
    assign og_image = article.image | default: og_image
  endif
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:type" content="{{ og_type }}">

{%- if og_image != blank -%}
  <meta property="og:image" content="http:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="1200">
  {%- if og_image.alt != blank -%}
    <meta property="og:image:alt" content="{{ og_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}

<meta name="twitter:card" content="{% if og_image != blank %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
