{% comment %}
  Full cart page. The drawer is the primary surface; this exists because Shopify
  requires a cart template and because /cart is still reachable directly.
{% endcomment %}
<section class="section">
  <div class="wrap" style="max-width:860px">
    <h1 class="h2">{{ section.settings.heading }}</h1>

    {%- if cart.item_count == 0 -%}
      <p class="lede" style="margin-top:20px">{{ section.settings.empty_text }}</p>
      <a class="btn btn--primary" style="margin-top:12px" href="{{ routes.all_products_collection_url }}">
        {{ section.settings.empty_cta }}
      </a>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate style="margin-top:32px">
        {%- for line in cart.items -%}
          <div class="drawer__row" style="grid-template-columns:96px 1fr">
            <div style="border:1px solid var(--line-soft);border-radius:8px;overflow:hidden;background:var(--surface)">
              {%- if line.image -%}
                <img
                  src="{{ line.image | image_url: width: 192 }}"
                  alt="{{ line.image.alt | escape }}"
                  width="96"
                  height="96"
                  loading="lazy"
                  style="width:100%;height:auto;display:block">
              {%- endif -%}
            </div>

            <div>
              <a href="{{ line.url }}" style="font:700 17px/1.3 var(--font)">{{ line.product.title }}</a>
              {%- unless line.variant.title contains 'Default' -%}
                <p style="margin:4px 0 0;font-size:14px;color:var(--muted)">{{ line.variant.title }}</p>
              {%- endunless -%}

              <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:14px;flex-wrap:wrap">
                <div class="qty">
                  <button
                    type="button"
                    data-qty-change="{{ line.quantity | minus: 1 }}"
                    data-line-key="{{ line.key }}"
                    aria-label="Decrease quantity">
                    &minus;
                  </button>
                  <input type="text" value="{{ line.quantity }}" aria-label="Quantity" readonly>
                  <button
                    type="button"
                    data-qty-change="{{ line.quantity | plus: 1 }}"
                    data-line-key="{{ line.key }}"
                    aria-label="Increase quantity">
                    +
                  </button>
                </div>
                <strong style="font:700 17px/1 var(--font);color:var(--ink)">
                  {{ line.final_line_price | money }}
                </strong>
              </div>
            </div>
          </div>
        {%- endfor -%}

        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:28px;font:700 20px/1 var(--font);color:var(--ink)">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>

        <p style="margin:10px 0 22px;font:400 14px/1.6 var(--font);color:var(--muted)">
          {{ section.settings.footnote }}
        </p>

        <button type="submit" name="checkout" class="btn btn--primary btn--block">Checkout</button>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty text",
      "default": "Nothing in here yet."
    },
    {
      "type": "text",
      "id": "empty_cta",
      "label": "Empty CTA",
      "default": "See the brush"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Taxes and import duties included. Shipping calculated at checkout."
    }
  ]
}
{% endschema %}
