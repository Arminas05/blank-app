{% comment %}
  Interactive calculator. Rendered server-side with the default values already
  filled in so it reads correctly with JS disabled; motion.js recomputes on input.
{% endcomment %}
{%- liquid
  assign mins = section.settings.default_mins
  assign cooks = section.settings.default_cooks
  assign weeks = section.settings.season_weeks
  assign target = section.settings.target_mins

  assign old_hours = mins | times: cooks | times: weeks | divided_by: 60.0
  assign new_hours = target | times: cooks | times: weeks | divided_by: 60.0
-%}

<section class="section">
  <div class="wrap">
    <div
      class="two"
      data-time-math
      data-weeks="{{ weeks }}"
      data-target="{{ target }}">
      <div data-reveal>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="h2">{{ section.settings.heading }}</h2>

        <div style="margin-top:34px">
          <label
            for="TimeMathMins"
            style="display:block;font:500 15px/1.6 var(--font);color:var(--body)">
            {{ section.settings.mins_label }}
            <strong data-out-mins style="color:var(--ink)">{{ mins }}</strong>
          </label>
          <input
            id="TimeMathMins"
            type="range"
            min="1"
            max="30"
            step="1"
            value="{{ mins }}"
            data-input-mins
            style="width:100%;accent-color:var(--ember)">
        </div>

        <div style="margin-top:22px">
          <label
            for="TimeMathCooks"
            style="display:block;font:500 15px/1.6 var(--font);color:var(--body)">
            {{ section.settings.cooks_label }}
            <strong data-out-cooks style="color:var(--ink)">{{ cooks }}</strong>
          </label>
          <input
            id="TimeMathCooks"
            type="range"
            min="1"
            max="14"
            step="1"
            value="{{ cooks }}"
            data-input-cooks
            style="width:100%;accent-color:var(--ember)">
        </div>
      </div>

      <div
        data-reveal
        style="background:var(--ink);border-radius:var(--radius);padding:44px;color:#d6d3d1">
        <p style="margin:0;font:500 14px/1.6 var(--font);color:#a8a29b">
          {{ section.settings.result_label | replace: '{weeks}', weeks }}
        </p>
        <p style="margin:10px 0 0">
          <strong data-out-hours style="font:900 64px/1 var(--font);color:#fff">
            {{ old_hours | round: 1 }}
          </strong>
        </p>
        <p style="margin:10px 0 0;font:400 16px/1.6 var(--font);color:#d6d3d1">
          {{ section.settings.result_suffix }}
        </p>

        <hr style="border:0;border-top:1px solid #292524;margin:28px 0">

        <p style="margin:0;font:500 14px/1.6 var(--font);color:#a8a29b">
          {{ section.settings.compare_label }}
        </p>
        <p style="margin:8px 0 0">
          <strong data-out-new style="font:800 28px/1 var(--font);color:var(--ember)">
            {{ new_hours | round: 1 }} hours
          </strong>
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Time math",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Do the math on your own grill"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How much of your summer goes into scrubbing?"
    },
    {
      "type": "text",
      "id": "mins_label",
      "label": "Minutes slider label",
      "default": "Minutes cleaning after a cook:"
    },
    {
      "type": "text",
      "id": "cooks_label",
      "label": "Cooks slider label",
      "default": "Cooks per week in season:"
    },
    {
      "type": "range",
      "id": "default_mins",
      "label": "Default minutes per clean",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 9
    },
    {
      "type": "range",
      "id": "default_cooks",
      "label": "Default cooks per week",
      "min": 1,
      "max": 14,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "season_weeks",
      "label": "Season length",
      "min": 8,
      "max": 52,
      "step": 1,
      "unit": "wk",
      "default": 26
    },
    {
      "type": "range",
      "id": "target_mins",
      "label": "Minutes per clean with GrillingBrush",
      "min": 0.5,
      "max": 5,
      "step": 0.5,
      "default": 1.5
    },
    {
      "type": "text",
      "id": "result_label",
      "label": "Result label",
      "info": "Use {weeks} for the season length.",
      "default": "Over a {weeks}-week season, that's"
    },
    {
      "type": "text",
      "id": "result_suffix",
      "label": "Result suffix",
      "default": "hours of scrubbing, stood over a warm grill."
    },
    {
      "type": "text",
      "id": "compare_label",
      "label": "Comparison label",
      "default": "Same season at 90 seconds a cook"
    }
  ],
  "presets": [{ "name": "Time math" }]
}
{% endschema %}
