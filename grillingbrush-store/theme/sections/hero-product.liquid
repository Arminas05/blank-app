{%- liquid
  assign product = section.settings.product | default: settings.featured_product
  case section.settings.headline_variant
    when 'b'
      assign headline = section.settings.headline_b
    when 'c'
      assign headline = section.settings.headline_c
    else
      assign headline = section.settings.headline_a
  endcase
-%}

<section class="section">
  <div class="wrap">
    <div class="two">
      <div data-reveal>
        <h1 class="h1">{{ headline }}</h1>

        <p class="lede" style="margin-top:26px">{{ section.settings.subhead }}</p>

        <div style="display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-top:32px">
          {% render 'buy-buttons', product: product, label: section.settings.cta_label %}
          {%- if section.settings.secondary_label != blank -%}
            <a class="link-underline" href="{{ section.settings.secondary_url }}">
              {{ section.settings.secondary_label }}
            </a>
          {%- endif -%}
        </div>

        <ul class="chips">
          {%- for block in section.blocks -%}
            {%- if block.type == 'chip' -%}
              <li class="chip" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div style="position:relative" data-reveal>
        <div
          aria-hidden="true"
          data-parallax="0.06"
          style="position:absolute;inset:-12% -8% auto auto;width:78%;aspect-ratio:1;background:radial-gradient(circle,rgba(232,89,12,.16) 0%,rgba(232,89,12,0) 68%);border-radius:50%;will-change:transform"></div>

        <div style="position:relative;border-radius:20px;overflow:hidden;background:#fff">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1400 }}"
              srcset="
                {{ section.settings.image | image_url: width: 700 }} 700w,
                {{ section.settings.image | image_url: width: 1100 }} 1100w,
                {{ section.settings.image | image_url: width: 1400 }} 1400w
              "
              sizes="(max-width: 900px) 100vw, 50vw"
              alt="{{ section.settings.image.alt | default: product.title | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              fetchpriority="high"
              style="width:100%;height:auto;display:block">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if section.settings.stat_value != blank -%}
          <div style="position:absolute;right:18px;bottom:18px;background:#fff;border:1px solid var(--line-soft);border-radius:14px;padding:16px 20px;box-shadow:0 18px 40px -30px rgba(18,16,14,.6)">
            <strong style="font:800 30px/1 var(--font);color:var(--ink)">{{ section.settings.stat_value }}</strong>
            <span style="font:500 13px/1 var(--font);color:var(--muted);margin-left:4px">
              {{ section.settings.stat_unit }}
            </span>
            <p style="margin:6px 0 0;font:400 13px/1.4 var(--font);color:var(--muted)">
              {{ section.settings.stat_caption }}
            </p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty to use the store-wide product from theme settings."
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "select",
      "id": "headline_variant",
      "label": "Headline variant",
      "info": "A/B/C copy test. Swap without editing the other two.",
      "options": [
        { "value": "a", "label": "A" },
        { "value": "b", "label": "B" },
        { "value": "c", "label": "C" }
      ],
      "default": "a"
    },
    {
      "type": "textarea",
      "id": "headline_a",
      "label": "Headline A",
      "default": "Strip a season of carbon off your grates in 90 seconds — using a motor, without scrubbing, soaking or a sore shoulder."
    },
    {
      "type": "textarea",
      "id": "headline_b",
      "label": "Headline B",
      "default": "Bare-metal grates in 90 seconds. Even if yours haven't been touched in years."
    },
    {
      "type": "textarea",
      "id": "headline_c",
      "label": "Headline C",
      "default": "Forget the elbow grease. A motor does the scrubbing, you just steer."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "A cordless motor spins a stainless head against the grate so you don't have to lean on it. One charge covers a month of cooking, and the head comes off with the wrench in the box so you can look at the wire before you cook — the part most brushes get wrong."
    },
    {
      "type": "header",
      "content": "Calls to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA",
      "info": "Use {price} to insert the live price.",
      "default": "Add to cart — {price}"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link",
      "default": "See how it's built"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary link URL"
    },
    {
      "type": "header",
      "content": "Image and stat"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "stat_value",
      "label": "Stat value",
      "default": "90"
    },
    {
      "type": "text",
      "id": "stat_unit",
      "label": "Stat unit",
      "default": "sec"
    },
    {
      "type": "text",
      "id": "stat_caption",
      "label": "Stat caption",
      "default": "full grate, both sides"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Trust chip",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "60-day money back"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "chip", "settings": { "text": "60-day money back" } },
        { "type": "chip", "settings": { "text": "Free US shipping" } },
        { "type": "chip", "settings": { "text": "Tracked, typically 10–14 days" } },
        { "type": "chip", "settings": { "text": "Duties paid at checkout" } }
      ]
    }
  ]
}
{% endschema %}
