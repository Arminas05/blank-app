<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div>
        <p class="wordmark" style="color:#fff">{{ settings.brand_name }}</p>
        <p style="max-width:38ch;margin-top:18px">{{ section.settings.blurb }}</p>
        <p>
          <a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a>
        </p>
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          {%- for link in block.settings.menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

    <p class="site-footer__legal">{{ section.settings.legal }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "One tool, one package, made properly. Shipped direct from the factory, with a person on the other end of the email."
    },
    {
      "type": "textarea",
      "id": "legal",
      "label": "Legal line",
      "default": "© 2026 GrillingBrush LLC. Contains a lithium-ion battery. Not for use on a hot grill."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Help" } },
      { "type": "menu", "settings": { "heading": "Company" } }
    ]
  },
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
