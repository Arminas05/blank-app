{%- assign product = section.settings.product | default: settings.featured_product -%}

<section class="section section--warm">
  <div class="wrap">
    <div class="two">
      <div data-reveal>
        {%- if section.settings.image != blank -%}
          <div style="border:1px solid var(--line-soft);border-radius:var(--radius);overflow:hidden;background:#fff">
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              alt="{{ section.settings.image.alt | default: product.title | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="lazy"
              style="width:100%;height:auto;display:block">
          </div>
        {%- endif -%}
      </div>

      <div data-reveal>
        <h2 class="h2">{{ section.settings.heading | default: product.title }}</h2>
        <p style="margin-top:14px;font:500 15px/1.6 var(--font);color:var(--muted)">
          {{ section.settings.subhead }}
        </p>

        <div style="margin-top:26px">
          {% render 'buy-buttons', product: product, label: section.settings.cta_label %}
        </div>

        <p style="margin-top:14px;font:400 14px/1.6 var(--font);color:var(--faint)">
          {{ section.settings.reassurance }}
        </p>

        {%- if section.blocks.size > 0 -%}
          <div style="margin-top:34px;border-top:1px solid var(--line-soft);padding-top:26px">
            <p class="eyebrow">{{ section.settings.box_heading }}</p>
            <ul style="margin:0;padding:0;list-style:none">
              {%- for block in section.blocks -%}
                <li
                  {{ block.shopify_attributes }}
                  style="padding:11px 0;border-bottom:1px solid var(--line-soft);font:400 15px/1.5 var(--font);color:var(--body)">
                  {{ block.settings.text }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Inline buy",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GrillingBrush R1 Electric Grill Brush"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "Cordless · stainless steel · detachable head"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Add to cart — {price}"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Reassurance line",
      "default": "60-day money back · free US shipping · one package"
    },
    {
      "type": "text",
      "id": "box_heading",
      "label": "In-the-box heading",
      "default": "In the box"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Box item",
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    }
  ],
  "presets": [
    {
      "name": "Inline buy",
      "blocks": [
        { "type": "item", "settings": { "text": "Brush body with built-in steel scraper" } },
        { "type": "item", "settings": { "text": "Rolling stainless wire head, installed" } },
        { "type": "item", "settings": { "text": "Head-changing wrench" } },
        { "type": "item", "settings": { "text": "Work gloves" } },
        { "type": "item", "settings": { "text": "USB-C charging cable" } },
        { "type": "item", "settings": { "text": "Safety and care card" } }
      ]
    }
  ]
}
{% endschema %}
