<section class="section">
  <div class="wrap">
    <div data-reveal style="max-width:80ch">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="h2">{{ page.title }}</h1>

      {%- if section.settings.standfirst != blank -%}
        <p class="lede" style="margin-top:20px;font-size:19px">{{ section.settings.standfirst }}</p>
      {%- endif -%}

      <div class="rte" style="margin-top:28px">{{ page.content }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "standfirst", "label": "Standfirst" }
  ]
}
{% endschema %}
